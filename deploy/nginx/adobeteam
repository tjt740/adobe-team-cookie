server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /opt/adobeteam/frontend-v2;
    index index.html;
    client_max_body_size 50m;

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /index.html { expires -1; add_header Cache-Control "no-store, no-cache, must-revalidate" always; }
    location ~* -patch\.js$ { expires -1; add_header Cache-Control "no-store, no-cache, must-revalidate" always; }

    location ^~ /v2/ {
        alias /opt/adobeteam/frontend-v2/;
        try_files $uri $uri/ /v2/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
