+def _read_firefly_profile(auth: "AdminAuth", a2: "AdminAuth", ent_guid: str,
+                          lf: LogFn, cap) -> tuple[str, dict]:
+    """Exchange the current session; an empty guid keeps Adobe's default profile."""
+    # ims/tokens force
+    try:
+        r = a2.client.post(
+            f"{_p.AUTH_HOST}/signin/v1/ims/tokens", headers=a2.headers(),
+            json={"rememberMe": True, "reauthenticate": "force"}, timeout=25)
+        cap(r)
+        t2 = _p.extract_token_from_obj(r.json()) if r.status_code == 200 else ""
+        if t2:
+            a2.susi_token = t2
+    except Exception as e:  # noqa: BLE001
+        lf(f"firefly type2e:ims/tokens 异常:{e}")
+
+    # Clio's fromSusi can keep the default personal identity even after a T2E
+    # mapping. Sunbreak establishes the enterprise IMS cookie using the same
+    # verified SUSI token, without another login or email challenge.
+    try:
+        session_auth = a2
+        if ent_guid and not ent_guid.endswith("@AdobeID") and a2.client_id == CLIO_CLIENT_ID:
+            session_auth = AdminAuth(auth.client, client_id=SUNBREAK_CLIENT_ID,
+                                     scope=SUNBREAK_SCOPE, redirect=SUNBREAK_REDIRECT)
+            session_auth.susi_token = a2.susi_token
+        session_auth.from_susi_token(None)
+    except Exception as e:  # noqa: BLE001
+        lf(f"firefly type2e:fromSusi 异常:{e}")
+
+    # clio check/v6/token(无 Bearer,靠 cookie)-> type2e firefly token
+    r = auth.client.post(
+        f"{_p.IMS_BACKEND}/ims/check/v6/token?jslVersion=v2-v0.54.0-3-g58cfcb7",
+        headers={"Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
+                 "client_id": CLIO_CLIENT_ID, "Origin": "https://firefly.adobe.com",
+                 "Referer": "https://firefly.adobe.com/"},
+        data=urlencode({"client_id": CLIO_CLIENT_ID, "guest_allowed": "true",
+                        "scope": FIREFLY_SCOPE}), timeout=25,
+    )
+    try:
+        data = r.json() if isinstance(r.json(), dict) else {}
+    except Exception:
+        data = {}
+    tok3 = data.get("access_token") or ""
+    acct = data.get("account_type") or ""
+    lf(f"firefly type2e:check/v6/token account_type={acct} got_token={bool(tok3)}")
+    if r.status_code != 200 or not tok3:
+        if r.status_code != 200:
+            raise _ProfileSwitchRejected(f"获取配置 Token 失败（HTTP {r.status_code}）", r.status_code)
+        raise _adm.AdminError("firefly check/v6/token 未返回 token status=200")
+    actual_id = data.get("userId") or extract_account_id(tok3)
+    expected_type = "type1" if (ent_guid or actual_id).endswith("@AdobeID") else "type2e"
+    claimed_id = extract_account_id(tok3)
+    if (not actual_id or acct != expected_type
+            or (claimed_id and claimed_id != actual_id)
+            or (ent_guid and actual_id != ent_guid)):
+        lf(f"firefly:配置身份核对失败 expected={ent_guid} actual={actual_id or '-'} type={acct or '-'}")
+        raise _adm.AdminError("firefly 配置切换后身份不一致,停止保存 Cookie 和积分")
+    context = {
+        "check_status": r.status_code,
+        "check_account_type": acct,
+        "check_user_id": actual_id,
+        "check_owner_org": data.get("ownerOrg") or "",
+        "check_client_id": data.get("client_id") or CLIO_CLIENT_ID,
+        "token_claims": _token_diagnostics(tok3),
+    }
+    try:
+        context.update(_prepare_firefly_context(auth, tok3, lf))
+    except Exception:
+        pass
+    return tok3, context
+
