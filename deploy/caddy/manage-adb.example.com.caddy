# 追加到 vps1 的 /etc/caddy/Caddyfile(与已有 :8788 站点并存)
# manage-adb.example.com -> 前端静态(frontend-v2) + /api/* 反代后端 uvicorn(127.0.0.1:8000)
manage-adb.example.com {
	encode zstd gzip
	request_body {
		max_size 50MB
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		root * /opt/adobeteam/frontend-v2
		@nocache path /index.html *-patch.js
		header @nocache Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		try_files {path} /index.html
		file_server
	}
}
